# Example environment variables for development
# Copy this file to `.env` and update values as needed

# Server
PORT=3000
NODE_ENV=development

# Database (Postgres)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=startrek_mmorpg
DB_USER=postgres
DB_PASSWORD=password
# Set to "true" to enable SSL connection to the DB
DB_SSL=false

# Connection tuning
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=5000

# CORS origin for the client (use your dev origin, e.g. http://localhost:5173)
CORS_ORIGIN=http://localhost:5173

# Optional: other secrets
# JWT_SECRET=your_jwt_secret_here
# OTHER_API_KEY=

# Notes:
# - In development the server will continue without a DB if connection fails.
# - For production, set NODE_ENV=production and ensure DB credentials are correct.
# Server Configuration
NODE_ENV=development
PORT=3000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=startrek_mmorpg
DB_USER=postgres
DB_PASSWORD=password
DB_SSL=false
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=5000

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Admin Access
ADMIN_API_KEY=your-admin-api-key-change-this

# CORS Configuration
CORS_ORIGIN=*

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Game Configuration
DEFAULT_TURN_DURATION=30
MAX_PLAYERS_PER_GALAXY=2000
GAME_SPEED_MULTIPLIER=1.0

# Cron Job Configuration
ENABLE_CRON_JOBS=true
CRON_TURN_PROCESSING=*/30 * * * *
CRON_RESOURCE_GENERATION=*/5 * * * *
CRON_SHIP_MOVEMENT=*/1 * * * *

# Logging
LOG_LEVEL=info
LOG_TO_FILE=false
LOG_FILE_PATH=./logs/game.log

# Redis (optional, for session storage)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# External APIs (optional)
EXTERNAL_API_KEY=
EXTERNAL_API_URL=

# Feature Flags
FEATURE_REAL_TIME_UPDATES=true
FEATURE_ADVANCED_COMBAT=true
FEATURE_DIPLOMACY=true
FEATURE_TRADE_SYSTEM=true

# Performance Tuning
MAX_CONCURRENT_BATTLES=10
MAX_ACTIONS_PER_TURN=50
BACKGROUND_PROCESSING_ENABLED=true

# Security
BCRYPT_ROUNDS=12
SESSION_TIMEOUT=7d
PASSWORD_MIN_LENGTH=6

# Development
DEBUG_SQL_QUERIES=false
MOCK_EXTERNAL_APIS=true
SKIP_AUTH_IN_DEV=false
